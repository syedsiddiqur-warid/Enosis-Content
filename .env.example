# Public URL of the app (used in emailed links)
APP_URL=http://localhost:3000

# Database. Leave empty to use embedded PGlite stored in PGLITE_DIR (local dev, nothing to install).
# For Supabase / Postgres, set the connection string, e.g.
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Who can sign in as admin: an explicit list, and/or everyone on a domain.
# In production, prefer an explicit list.
ADMIN_EMAILS=you@enosisbd.com
ADMIN_ALLOWED_DOMAIN=enosisbd.com

# Email: "dev" stores messages in the dev inbox at /dev/inbox (nothing is sent).
# Real providers: resend | postmark | sendgrid (set the matching key below).
# Real providers never send to resources whose email is still a sample/unverified address.
EMAIL_PROVIDER=dev
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
EMAIL_FROM="Enosis Talent Team <talent@enosisbd.com>"

# Domain used for generated sample addresses (firstname.lastname@<domain>) until real emails are loaded.
SAMPLE_EMAIL_DOMAIN=enosisbd.com

# A record not updated for this many days is marked stale.
STALE_AFTER_DAYS=60

# Protects /api/cron/reminders (Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Salt for hashing visitor IPs in the link audit log (raw IPs are never stored).
AUDIT_SALT=change-me

# Later phases:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
